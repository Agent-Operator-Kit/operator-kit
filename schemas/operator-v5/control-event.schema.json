{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoperatorkit.dev/schemas/operator-v5/control-event.schema.json",
  "$comment": "JSON Schema validates structure and semantic integers only. Raw bytes MUST first pass Operator Canonical JSON v1 lexical parsing, which rejects decimal, exponent, and negative-zero number spellings before schema validation, hashing, signing, or persistence.",
  "title": "Operator V5 Control Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "eventId", "requestId", "requestFingerprint", "occurredAt", "clock", "actor", "type", "intent", "expectedRevision", "data", "result", "proof"],
  "properties": {
    "schemaVersion": {"const": "operator.control-event/v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "eventId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "requestFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "clock": {
      "type": "object", "additionalProperties": false, "required": ["hostId", "bootId", "monotonicSource", "monotonicNs"],
      "properties": {
        "hostId": {"type": "string", "minLength": 1, "maxLength": 256},
        "bootId": {"type": "string", "minLength": 1, "maxLength": 256},
        "monotonicSource": {"enum": ["linux-proc-uptime", "macos-mach-continuous"]},
        "monotonicNs": {"type": "integer", "minimum": 0}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "bindingId", "bindingGeneration", "bindingHash", "capabilityHash", "projectId", "graphId", "issuedAt", "expiresAt", "keyId", "signature", "capabilities", "subject", "leaseScopes", "proofKey", "authorityHash"],
      "properties": {
        "type": {"enum": ["operator", "lane", "host", "human", "subagent", "system"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "bindingId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]*$"},
        "bindingGeneration": {"type": "integer", "minimum": 1},
        "bindingHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capabilityHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authorityHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "projectId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "graphId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "issuedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "keyId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[A-Za-z0-9_-]+$"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["graph-init", "graph-replace", "gate-decision", "lease", "transition", "sweep", "lease-resolve", "replay-repair"]}
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": {"enum": ["operator", "lane", "host", "human", "subagent", "system"]},
            "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
            "laneNodeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
            "hostRunnerId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"}
          },
          "allOf": [
            {
              "if": {"properties": {"type": {"const": "lane"}}, "required": ["type"]},
              "then": {"required": ["laneNodeId"], "not": {"required": ["hostRunnerId"]}}
            },
            {
              "if": {"properties": {"type": {"const": "host"}}, "required": ["type"]},
              "then": {"required": ["hostRunnerId"], "not": {"required": ["laneNodeId"]}}
            },
            {
              "if": {"properties": {"type": {"enum": ["operator", "human", "subagent", "system"]}}, "required": ["type"]},
              "then": {"not": {"anyOf": [{"required": ["laneNodeId"]}, {"required": ["hostRunnerId"]}]}}
            }
          ]
        },
        "leaseScopes": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "laneNodeId"],
            "properties": {
              "scope": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
              "laneNodeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"}
            }
          }
        },
        "proofKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyId", "algorithm", "publicKey"],
          "properties": {
            "keyId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
            "algorithm": {"const": "RS256"},
            "publicKey": {
              "type": "object", "additionalProperties": false, "required": ["n", "e"],
              "properties": {
                "n": {"type": "string", "minLength": 256, "maxLength": 2048, "pattern": "^[0-9a-f]+$"},
                "e": {"enum": [3, 65537]}
              }
            }
          }
        }
      }
    },
    "type": {
      "enum": ["graph.initialized", "definition.replaced", "node.transitioned", "gate.decided", "lease.acquired", "lease.renewed", "lease.released", "lease.swept", "lease.resolved", "replay.repaired"]
    },
    "intent": {"$ref": "#/$defs/canonicalObject"},
    "expectedRevision": {"type": ["integer", "null"], "minimum": 1},
    "data": {"$ref": "#/$defs/canonicalObject"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "requestId", "revision", "data"],
      "properties": {
        "ok": {"const": true},
        "command": {"enum": ["init", "replace-definition", "transition", "gate decide", "lease acquire", "lease renew", "lease release", "lease sweep", "lease resolve", "replay repair"]},
        "requestId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "revision": {"type": "integer", "minimum": 1},
        "data": {"$ref": "#/$defs/canonicalObject"}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "proofKeyId", "algorithm", "authorizationSignature", "eventSignature"],
      "properties": {
        "schemaVersion": {"const": "operator.mutation-event-proof/v1"},
        "proofKeyId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "algorithm": {"const": "RS256"},
        "authorizationSignature": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[A-Za-z0-9_-]+$"},
        "eventSignature": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[A-Za-z0-9_-]+$"}
      }
    }
  },
  "$defs": {
    "canonicalObject": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/canonicalValue"}
    },
    "canonicalValue": {
      "oneOf": [
        {"$ref": "#/$defs/canonicalObject"},
        {"type": "array", "items": {"$ref": "#/$defs/canonicalValue"}},
        {"type": "string"},
        {"type": "integer"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "graph.initialized"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "init"}}}}}},
    {"if": {"properties": {"type": {"const": "definition.replaced"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "replace-definition"}}}}}},
    {"if": {"properties": {"type": {"const": "node.transitioned"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "transition"}}}}}},
    {"if": {"properties": {"type": {"const": "gate.decided"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "gate decide"}}}}}},
    {"if": {"properties": {"type": {"const": "lease.acquired"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "lease acquire"}}}}}},
    {"if": {"properties": {"type": {"const": "lease.renewed"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "lease renew"}}}}}},
    {"if": {"properties": {"type": {"const": "lease.released"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "lease release"}}}}}},
    {"if": {"properties": {"type": {"const": "lease.swept"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "lease sweep"}}}}}},
    {"if": {"properties": {"type": {"const": "lease.resolved"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "lease resolve"}}}}}},
    {"if": {"properties": {"type": {"const": "replay.repaired"}}}, "then": {"properties": {"result": {"properties": {"command": {"const": "replay repair"}}}}}}
  ]
}
