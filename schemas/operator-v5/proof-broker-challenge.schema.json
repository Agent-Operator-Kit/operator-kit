{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoperatorkit.dev/schemas/operator-v5/proof-broker-challenge.schema.json",
  "title": "Operator V5 Proof Broker Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "phase", "proofKeyId", "payload"],
  "properties": {
    "schemaVersion": {"const": "operator.proof-challenge/v1"},
    "operation": {"const": "sign"},
    "phase": {"enum": ["authorize", "event"]},
    "proofKeyId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {
      "properties": {"phase": {"const": "authorize"}, "payload": {"$ref": "mutation-authorization.schema.json"}},
      "required": ["phase", "payload"]
    },
    {
      "properties": {"phase": {"const": "event"}, "payload": {"$ref": "mutation-event-proof-payload.schema.json"}},
      "required": ["phase", "payload"]
    }
  ]
}
