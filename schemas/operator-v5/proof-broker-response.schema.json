{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoperatorkit.dev/schemas/operator-v5/proof-broker-response.schema.json",
  "title": "Operator V5 Proof Broker Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "proofKeyId", "signature"],
  "properties": {
    "schemaVersion": {"const": "operator.proof-response/v1"},
    "phase": {"enum": ["authorize", "event"]},
    "proofKeyId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "signature": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[A-Za-z0-9_-]+$"}
  }
}
