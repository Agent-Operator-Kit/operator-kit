{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoperatorkit.dev/schemas/operator-v5/control-graph.schema.json",
  "title": "Operator V5 Control Graph Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graphId", "nodes", "edges"],
  "properties": {
    "schemaVersion": {"const": "operator.control-graph/v1"},
    "graphId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "definitionRevision": {"type": "integer", "minimum": 1},
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 50000,
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "kind": {
          "enum": ["goal", "feature", "lane", "task", "validation", "human-gate", "integration", "feedback"]
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "initialState": {
          "enum": ["planned", "pending", "ready", "active", "blocked", "completed", "failed", "cancelled", "approved", "rejected"]
        },
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "metadata": {
          "type": "object",
          "properties": {
            "execution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["idempotent", "reclaimable"],
              "properties": {
                "idempotent": {"type": "boolean"},
                "reclaimable": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 384, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "kind": {
          "enum": ["contains", "depends-on", "assigned-to", "validated-by", "gated-by", "integrates-into", "feedback-for"]
        },
        "from": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "to": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "metadata": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "gated-by"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "protectedTransitions": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"enum": ["ready", "active", "completed", "blocked", "failed", "cancelled"]}
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
