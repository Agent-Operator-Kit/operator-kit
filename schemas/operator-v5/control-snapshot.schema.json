{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoperatorkit.dev/schemas/operator-v5/control-snapshot.schema.json",
  "$comment": "JSON Schema validates structure and semantic integers only. Raw bytes MUST first pass Operator Canonical JSON v1 lexical parsing, which rejects decimal, exponent, and negative-zero number spellings before schema validation, hashing, signing, or persistence.",
  "title": "Operator V5 Locked Control Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graphId", "revision", "definitionRevision", "definitionHash", "updatedAt", "eventCount", "nodes", "edges", "leases", "leaseFences", "executionStarted", "reconciliations", "bindingGenerations", "authorityKeyId", "authorityHash"],
  "properties": {
    "schemaVersion": {"const": "operator.control-snapshot/v1"},
    "graphId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "definitionRevision": {"type": "integer", "minimum": 1},
    "definitionHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "eventCount": {"type": "integer", "minimum": 1},
    "authorityKeyId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "authorityHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nodes": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "title", "initialState", "priority", "metadata", "state"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
          "kind": {"enum": ["goal", "feature", "lane", "task", "validation", "human-gate", "integration", "feedback"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 512},
          "initialState": {"enum": ["planned", "pending"]},
          "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
          "metadata": {"$ref": "#/$defs/canonicalObject"},
          "state": {"enum": ["planned", "pending", "ready", "active", "blocked", "completed", "failed", "cancelled", "approved", "rejected"]}
        }
      }
    },
    "edges": {
      "type": "array", "maxItems": 50000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "from", "to", "metadata"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 384, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
          "kind": {"enum": ["contains", "depends-on", "assigned-to", "validated-by", "gated-by", "integrates-into", "feedback-for"]},
          "from": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
          "to": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
          "metadata": {"$ref": "#/$defs/canonicalObject"}
        }
      }
    },
    "leases": {"type": "object", "maxProperties": 10000, "additionalProperties": {"$ref": "ownership-lease.schema.json"}},
    "leaseFences": {"type": "object", "maxProperties": 10000, "additionalProperties": {"type": "integer", "minimum": 1}},
    "executionStarted": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["revision", "occurredAt"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "occurredAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "reconciliations": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["leaseId", "fence", "reason", "requiredAt", "priorState"],
        "properties": {
          "leaseId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
          "fence": {"type": "integer", "minimum": 1},
          "reason": {"enum": ["expired-unsafe", "binding-rotated", "clock-recovery"]},
          "requiredAt": {"type": "string", "format": "date-time"},
          "priorState": {"enum": ["pending", "ready", "active", "blocked", "completed", "failed", "cancelled"]}
        }
      }
    },
    "bindingGenerations": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["generation", "bindingHash"],
        "properties": {
          "generation": {"type": "integer", "minimum": 1},
          "bindingHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "canonicalObject": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/canonicalValue"}
    },
    "canonicalValue": {
      "oneOf": [
        {"$ref": "#/$defs/canonicalObject"},
        {"type": "array", "items": {"$ref": "#/$defs/canonicalValue"}},
        {"type": "string"},
        {"type": "integer"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    }
  }
}
