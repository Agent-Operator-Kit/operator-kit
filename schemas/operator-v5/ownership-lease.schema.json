{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoperatorkit.dev/schemas/operator-v5/ownership-lease.schema.json",
  "$comment": "JSON Schema validates structure and semantic integers only. Raw bytes MUST first pass Operator Canonical JSON v1 lexical parsing, which rejects decimal, exponent, and negative-zero number spellings before schema validation, hashing, signing, or persistence.",
  "title": "Operator V5 Ownership Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nodeId", "leaseId", "holder", "acquiredAt", "renewedAt", "expiresAt", "fence", "clock"],
  "properties": {
    "schemaVersion": {"const": "operator.ownership-lease/v1"},
    "nodeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "leaseId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorType", "actorId", "bindingId", "bindingGeneration", "bindingHash", "scope", "laneNodeId"],
      "properties": {
        "actorType": {"enum": ["lane", "host"]},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "bindingId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]*$"},
        "bindingGeneration": {"type": "integer", "minimum": 1},
        "bindingHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"},
        "laneNodeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"}
      }
    },
    "acquiredAt": {"type": "string", "format": "date-time"},
    "renewedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "fence": {"type": "integer", "minimum": 1},
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "bootId", "monotonicSource", "acquiredMonotonicNs", "expiresMonotonicNs"],
      "properties": {
        "hostId": {"type": "string", "minLength": 1, "maxLength": 256},
        "bootId": {"type": "string", "minLength": 1, "maxLength": 256},
        "monotonicSource": {"enum": ["linux-proc-uptime", "macos-mach-continuous"]},
        "acquiredMonotonicNs": {"type": "integer", "minimum": 0},
        "expiresMonotonicNs": {"type": "integer", "minimum": 1}
      }
    }
  }
}
