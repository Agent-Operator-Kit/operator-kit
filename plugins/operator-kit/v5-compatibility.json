{
  "name": "operator-kit-v5-compatibility",
  "schemaVersion": 1,
  "projectKitVersion": "5",
  "migrationSourceVersions": [
    "4"
  ],
  "pluginVersion": "0.4.6",
  "releaseSemverChanged": false,
  "historicalBundle": "v3-adapter-bundle.json",
  "requiredProjectRuntime": [
    "scripts/operator-role-map.sh",
    "scripts/operator-graph.sh",
    "scripts/operator_graph.py",
    "scripts/operator-scheduler.sh",
    "scripts/operator-loop.sh",
    "scripts/operator-host.sh",
    "scripts/operator-proof-broker.sh",
    "scripts/operator_host.py",
    "scripts/operator-design-flow.sh",
    "scripts/operator_design_provider.py",
    "scripts/operator-v5-migrate.sh",
    "scripts/operator_v5_migrate.py",
    "schemas/operator-v5/"
  ],
  "hostAdapters": [
    {
      "host": "codex",
      "path": ".codex-plugin/plugin.json",
      "version": "0.4.6"
    },
    {
      "host": "cursor",
      "path": "adapters/cursor/adapter.json",
      "version": "0.1.0"
    },
    {
      "host": "claude-code",
      "path": "adapters/claude-code/adapter.json",
      "version": "0.1.0"
    }
  ],
  "safety": {
    "graphAuthority": "signed append-only control graph",
    "productionBypassAllowed": false,
    "privateKeysInProjectOrOperatorDirAllowed": false,
    "freshInstallInitializesGraphOrKeys": false,
    "plainV4UpdateChangesMarker": false,
    "explicitReviewedMigrationRequired": true
  }
}
