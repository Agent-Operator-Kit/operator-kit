PROJECT_NAME="sample-workspace"
PROJECT_ROOT="$HOME/Projects/sample-workspace"
CODE_DIR="$PROJECT_ROOT/code"
OPERATOR_DIR="$PROJECT_ROOT/operator"
TMUX_SESSION="sample-workspace"
DEFAULT_BRANCH="main"
OPERATOR_KIT_VERSION="2"

OPERATOR_LANES='
operator|Codex Desktop|app|main|
backend|Codex CLI|app-admin|codex/admin-backend|codex --sandbox workspace-write --ask-for-approval never
mobile-backend|Codex CLI|app-mobile-backend|codex/mobile-backend|codex --sandbox workspace-write --ask-for-approval never
mobile-ui|Claude Code|app-mobile-ui|claude/ui-mobile|claude --model fable --safe-mode --permission-mode dontAsk
web-ui|Claude Code|app-admin-ui|claude/ui-admin|claude --model fable --safe-mode --permission-mode dontAsk
release|Codex CLI|app-release|staging|codex --sandbox workspace-write --ask-for-approval never
product|Codex CLI|app-product|codex/product|codex --sandbox workspace-write --ask-for-approval never
'
